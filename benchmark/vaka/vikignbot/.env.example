# Existing Vaka proxy used only for /v1/cases/query.
VAKA_VIKINGBOT_CASE_SERVICE_URL=http://127.0.0.1:8765

# Adapter HTTP address.
VAKA_VIKINGBOT_HOST=127.0.0.1
VAKA_VIKINGBOT_PORT=8766
VAKA_VIKINGBOT_MAX_CONCURRENCY=20
VAKA_VIKINGBOT_ROLLOUT_TIMEOUT_SECONDS=3600
VAKA_VIKINGBOT_MAX_ITERATIONS=30
VAKA_VIKINGBOT_KEEP_SESSION_WORKSPACES=true

# Defaults to evolution/components/ov-benchmark-proxy/.env and reuses its
# VAKA_USERS_FILE/HOME_TEST_* settings. Override only when needed.
# VAKA_VIKINGBOT_PROXY_ENV=/absolute/path/to/ov-benchmark-proxy/.env

# Optional direct Homepage identity. Prefer VAKA_USERS_FILE in the proxy env.
# VAKA_VIKINGBOT_HOMEPAGE_API_KEY=
# VAKA_VIKINGBOT_HOMEPAGE_USER_ID=

# Debug-only: run chat and return a rollout without HomeTest scoring/upload.
VAKA_VIKINGBOT_SKIP_SCORING=false
